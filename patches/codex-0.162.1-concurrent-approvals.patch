new file mode 100644
index 0000000..c336f8f
--- /dev/null
+++ b/codex-rs/telegram-approvals/src/lib.rs
@@ -0,0 +1,428 @@
+//! Concurrent external review. Policy hooks run before this reviewer is reached.
+//! Native decisions win until the server atomically commits the external response.
+use std::future::Future;
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use anyhow::{Context, Result, bail};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use tokio::sync::mpsc;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Mode {
+    #[default]
+    Computer,
+    Telegram,
+    Concurrent,
+}
+
+fn default_veto_seconds() -> u64 {
+    5
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Settings {
+    pub mode: Mode,
+    #[serde(default = "default_veto_seconds")]
+    pub veto_seconds: u64,
+}
+
+impl Default for Settings {
+    fn default() -> Self {
+        Self {
+            mode: Mode::Computer,
+            veto_seconds: 5,
+        }
+    }
+}
+
+pub fn config_dir() -> Result<PathBuf> {
+    let home = std::env::var_os("HOME").context("HOME is unavailable")?;
+    Ok(PathBuf::from(home).join(".config/codex-telegram-approve"))
+}
+
+impl Settings {
+    pub fn load(dir: &Path) -> Result<Self> {
+        let settings: Self = match std::fs::read(dir.join("mode.json")) {
+            Ok(bytes) => serde_json::from_slice(&bytes)?,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Self::default(),
+            Err(error) => return Err(error.into()),
+        };
+        if !(1..=60).contains(&settings.veto_seconds) {
+            bail!("veto_seconds must be between 1 and 60");
+        }
+        Ok(settings)
+    }
+
+    pub fn save(&self, dir: &Path) -> Result<()> {
+        if !(1..=60).contains(&self.veto_seconds) {
+            bail!("veto_seconds must be between 1 and 60");
+        }
+        std::fs::create_dir_all(dir)?;
+        let file = tempfile::NamedTempFile::new_in(dir)?;
+        serde_json::to_writer(file.as_file(), self)?;
+        file.as_file().sync_all()?;
+        file.persist(dir.join("mode.json"))?;
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Status {
+    Waiting,
+    Countdown(bool, u64),
+    Unavailable,
+}
+
+pub enum Outcome<T> {
+    Terminal(T),
+    Telegram(bool),
+}
+
+/// A native response (including disconnect/error) always wins a ready tie.
+/// Transport failure is not a vote: keep the native prompt available.
+pub async fn arbitrate<T>(
+    native: impl Future<Output = T>,
+    remote: impl Future<Output = Result<bool>>,
+    veto: Duration,
+    status: mpsc::UnboundedSender<Status>,
+) -> Outcome<T> {
+    tokio::pin!(native);
+    tokio::pin!(remote);
+    let _ = status.send(Status::Waiting);
+    let remote = tokio::select! {
+        biased;
+        value = &mut native => return Outcome::Terminal(value),
+        value = &mut remote => value,
+    };
+    let approved = match remote {
+        Ok(approved) => approved,
+        Err(_) => {
+            let _ = status.send(Status::Unavailable);
+            return Outcome::Terminal(native.await);
+        }
+    };
+    // Both remote votes are provisional: the terminal may override either one.
+    // A denied request will not execute after the grace period.
+    let deadline = tokio::time::Instant::now() + veto;
+    let mut tick = tokio::time::interval(Duration::from_secs(1));
+    loop {
+        tokio::select! {
+            biased;
+            value = &mut native => return Outcome::Terminal(value),
+            _ = tokio::time::sleep_until(deadline) => return Outcome::Telegram(approved),
+            _ = tick.tick() => {
+                let remaining = deadline.saturating_duration_since(tokio::time::Instant::now()).as_millis().div_ceil(1000) as u64;
+                let _ = status.send(Status::Countdown(approved, remaining));
+            }
+        }
+    }
+}
+
+/// Credential material stays in the native server and never enters UI events.
+pub async fn request(dir: &Path, method: &str, params: Value, veto_seconds: u64) -> Result<bool> {
+    #[derive(Deserialize)]
+    struct Bridge {
+        root: PathBuf,
+        bridge_url: Option<String>,
+    }
+    let bridge: Bridge = serde_json::from_slice(&std::fs::read(dir.join("hook.json"))?)?;
+    let env = std::fs::read_to_string(bridge.root.join(".env"))?;
+    let token = env
+        .lines()
+        .find_map(|line| line.strip_prefix("BRIDGE_TOKEN="))
+        .context("missing bridge credential")?;
+    if token.len() < 32 || !token.bytes().all(|byte| (33..=126).contains(&byte)) {
+        bail!("invalid bridge credential");
+    }
+    let mut url = reqwest::Url::parse(
+        bridge
+            .bridge_url
+            .as_deref()
+            .unwrap_or("http://127.0.0.1:8787"),
+    )?;
+    if !url.username().is_empty()
+        || url.password().is_some()
+        || url.query().is_some()
+        || url.fragment().is_some()
+        || !(url.scheme() == "https"
+            || (url.scheme() == "http"
+                && matches!(
+                    url.host_str(),
+                    Some("127.0.0.1" | "localhost" | "[::1]" | "::1")
+                )))
+    {
+        bail!("invalid bridge URL");
+    }
+    url.set_path(&format!(
+        "{}/v1/approvals",
+        url.path().trim_end_matches('/')
+    ));
+    let client = reqwest::Client::builder()
+        .redirect(reqwest::redirect::Policy::none())
+        .timeout(Duration::from_secs(1850))
+        .build()?;
+    let payload = serde_json::json!({"method": method, "host": "Codex native concurrent review", "params": params, "vetoSeconds": veto_seconds});
+    let mut response = client
+        .post(url)
+        .bearer_auth(token)
+        .json(&payload)
+        .send()
+        .await?
+        .error_for_status()?;
+    if response.content_length().is_some_and(|size| size > 4096) {
+        bail!("oversized bridge response");
+    }
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await? {
+        if bytes.len() + chunk.len() > 4096 {
+            bail!("oversized bridge response");
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    let result: Value = serde_json::from_slice(&bytes)?;
+    if result["source"].as_str() != Some("telegram") {
+        bail!("bridge did not return an explicit phone vote");
+    }
+    match result["decision"].as_str() {
+        Some("accept") => Ok(true),
+        Some("decline") => Ok(false),
+        _ => bail!("invalid bridge decision"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::future::{pending, ready};
+    use tokio::sync::oneshot;
+
+    #[tokio::test(start_paused = true)]
+    async fn native_wins_ready_tie() {
+        let (status, _) = mpsc::unbounded_channel();
+        assert!(matches!(
+            arbitrate(
+                ready(false),
+                ready(Ok(true)),
+                Duration::from_secs(5),
+                status
+            )
+            .await,
+            Outcome::Terminal(false)
+        ));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn native_denial_overrides_remote_approval() {
+        let (sender, receiver) = oneshot::channel();
+        let (status, mut updates) = mpsc::unbounded_channel();
+        let task = tokio::spawn(arbitrate(
+            receiver,
+            ready(Ok(true)),
+            Duration::from_secs(5),
+            status,
+        ));
+        assert_eq!(updates.recv().await, Some(Status::Waiting));
+        let _ = updates.recv().await;
+        sender.send(false).unwrap();
+        assert!(matches!(task.await.unwrap(), Outcome::Terminal(Ok(false))));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn remote_approval_cannot_execute_before_deadline() {
+        let (status, mut updates) = mpsc::unbounded_channel();
+        let task = tokio::spawn(arbitrate(
+            pending::<()>(),
+            ready(Ok(true)),
+            Duration::from_secs(5),
+            status,
+        ));
+        let _ = updates.recv().await;
+        let _ = updates.recv().await;
+        tokio::time::advance(Duration::from_secs(4)).await;
+        assert!(!task.is_finished());
+        tokio::time::advance(Duration::from_secs(1)).await;
+        assert!(matches!(task.await.unwrap(), Outcome::Telegram(true)));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn unavailable_remote_leaves_native_pending() {
+        let (sender, receiver) = oneshot::channel();
+        let (status, mut updates) = mpsc::unbounded_channel();
+        let task = tokio::spawn(arbitrate(
+            receiver,
+            ready(Err(anyhow::anyhow!("offline"))),
+            Duration::from_secs(5),
+            status,
+        ));
+        assert_eq!(updates.recv().await, Some(Status::Waiting));
+        assert_eq!(updates.recv().await, Some(Status::Unavailable));
+        assert!(!task.is_finished());
+        sender.send(true).unwrap();
+        assert!(matches!(task.await.unwrap(), Outcome::Terminal(Ok(true))));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn terminal_wins_at_exact_deadline() {
+        let (status, _) = mpsc::unbounded_channel();
+        let native = async {
+            tokio::time::sleep(Duration::from_secs(5)).await;
+            false
+        };
+        assert!(matches!(
+            arbitrate(native, ready(Ok(true)), Duration::from_secs(5), status).await,
+            Outcome::Terminal(false)
+        ));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn terminal_approval_overrides_telegram_denial() {
+        let (status, _) = mpsc::unbounded_channel();
+        let native = async {
+            tokio::time::sleep(Duration::from_secs(1)).await;
+            true
+        };
+        assert!(matches!(
+            arbitrate(native, ready(Ok(false)), Duration::from_secs(5), status).await,
+            Outcome::Terminal(true)
+        ));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn native_disconnect_drops_remote_work() {
+        struct Dropped(std::sync::Arc<std::sync::atomic::AtomicBool>);
+        impl Drop for Dropped {
+            fn drop(&mut self) {
+                self.0.store(true, std::sync::atomic::Ordering::SeqCst);
+            }
+        }
+        let dropped = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let guard = Dropped(dropped.clone());
+        let remote = async move {
+            let _guard = guard;
+            pending::<Result<bool>>().await
+        };
+        let (status, _) = mpsc::unbounded_channel();
+        let result = arbitrate(
+            ready("disconnected"),
+            remote,
+            Duration::from_secs(5),
+            status,
+        )
+        .await;
+        assert!(matches!(result, Outcome::Terminal("disconnected")));
+        assert!(dropped.load(std::sync::atomic::Ordering::SeqCst));
+    }
+
+    #[test]
+    fn settings_round_trip_and_validation() {
+        let dir = tempfile::tempdir().unwrap();
+        assert_eq!(Settings::load(dir.path()).unwrap().mode, Mode::Computer);
+        Settings {
+            mode: Mode::Concurrent,
+            veto_seconds: 5,
+        }
+        .save(dir.path())
+        .unwrap();
+        assert_eq!(Settings::load(dir.path()).unwrap().mode, Mode::Concurrent);
+        std::fs::write(
+            dir.path().join("mode.json"),
+            r#"{"mode":"concurrent","veto_seconds":0}"#,
+        )
+        .unwrap();
+        assert!(Settings::load(dir.path()).is_err());
+    }
+
+    #[tokio::test]
+    async fn bridge_wire_contract_and_redirect_rejection() {
+        use std::io::{Read, Write};
+        for (reply, expected) in [
+            (
+                "HTTP/1.1 200 OK\r\nContent-Length: 41\r\n\r\n{\"decision\":\"decline\",\"source\":\"timeout\"}",
+                None,
+            ),
+            (
+                "HTTP/1.1 200 OK\r\nContent-Length: 21\r\n\r\n{\"decision\":\"accept\"}",
+                None,
+            ),
+            (
+                "HTTP/1.1 200 OK\r\nContent-Length: 41\r\n\r\n{\"decision\":\"accept\",\"source\":\"telegram\"}",
+                Some(true),
+            ),
+            (
+                "HTTP/1.1 200 OK\r\nContent-Length: 42\r\n\r\n{\"decision\":\"decline\",\"source\":\"telegram\"}",
+                Some(false),
+            ),
+            (
+                "HTTP/1.1 302 Found\r\nLocation: http://127.0.0.1:1/secret\r\nContent-Length: 0\r\n\r\n",
+                None,
+            ),
+        ] {
+            let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+            let url = format!("http://{}", listener.local_addr().unwrap());
+            let server = std::thread::spawn(move || {
+                let (mut stream, _) = listener.accept().unwrap();
+                stream
+                    .set_read_timeout(Some(Duration::from_secs(5)))
+                    .unwrap();
+                let mut bytes = Vec::new();
+                let mut buffer = [0; 4096];
+                loop {
+                    let count = stream.read(&mut buffer).unwrap();
+                    assert!(count > 0);
+                    bytes.extend_from_slice(&buffer[..count]);
+                    if let Some(offset) = bytes.windows(4).position(|part| part == b"\r\n\r\n") {
+                        let headers =
+                            String::from_utf8_lossy(&bytes[..offset]).to_ascii_lowercase();
+                        let length: usize = headers
+                            .lines()
+                            .find_map(|line| line.strip_prefix("content-length: "))
+                            .unwrap()
+                            .parse()
+                            .unwrap();
+                        if bytes.len() >= offset + 4 + length {
+                            break;
+                        }
+                    }
+                }
+                let wire = String::from_utf8(bytes).unwrap();
+                assert!(wire.starts_with("POST /v1/approvals "));
+                assert!(
+                    wire.to_ascii_lowercase()
+                        .contains(&format!("authorization: bearer {}", "x".repeat(32)))
+                );
+                let body: Value =
+                    serde_json::from_str(wire.split_once("\r\n\r\n").unwrap().1).unwrap();
+                assert_eq!(body["vetoSeconds"], 5);
+                assert_eq!(body["params"]["command"], "echo test");
+                stream.write_all(reply.as_bytes()).unwrap();
+            });
+            let dir = tempfile::tempdir().unwrap();
+            std::fs::write(
+                dir.path().join(".env"),
+                format!("BRIDGE_TOKEN={}\r\n", "x".repeat(32)),
+            )
+            .unwrap();
+            std::fs::write(
+                dir.path().join("hook.json"),
+                serde_json::to_vec(&serde_json::json!({"root": dir.path(), "bridge_url": url}))
+                    .unwrap(),
+            )
+            .unwrap();
+            let result = request(
+                dir.path(),
+                "item/commandExecution/requestApproval",
+                serde_json::json!({"command":"echo test"}),
+                5,
+            )
+            .await;
+            match expected {
+                Some(value) => assert_eq!(result.unwrap(), value),
+                None => assert!(result.is_err()),
+            }
+            server.join().unwrap();
+        }
+    }
+}
