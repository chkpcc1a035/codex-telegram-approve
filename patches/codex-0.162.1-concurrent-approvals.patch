+//! Native slash command and per-request status shared by approval renderers.
+use codex_telegram_approvals::{Mode, Settings};
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+
+type Key = (String, String);
+static STATUSES: OnceLock<Mutex<HashMap<Key, String>>> = OnceLock::new();
+
+pub(crate) fn update(thread: String, approval: String, message: String) {
+    if let Ok(mut statuses) = STATUSES.get_or_init(Default::default).lock() {
+        // Bound stale entries if a client disconnects without a resolution event.
+        if statuses.len() >= 256 {
+            statuses.clear();
+        }
+        statuses.insert((thread, approval), message);
+    }
+}
+
+pub(crate) fn status(thread: String, approval: String) -> Option<String> {
+    STATUSES
+        .get_or_init(Default::default)
+        .lock()
+        .ok()?
+        .get(&(thread, approval))
+        .cloned()
+}
+
+pub(crate) fn remove(thread: String, approval: String) {
+    if let Ok(mut statuses) = STATUSES.get_or_init(Default::default).lock() {
+        statuses.remove(&(thread, approval));
+    }
+}
+
+pub(crate) fn command(arguments: &str) -> anyhow::Result<String> {
+    let dir = codex_telegram_approvals::config_dir()?;
+    command_in(&dir, arguments)
+}
+
+fn command_in(dir: &std::path::Path, arguments: &str) -> anyhow::Result<String> {
+    let mut words = arguments.split_whitespace();
+    let action = words.next().unwrap_or("status");
+    // Explicit selection can repair a malformed settings file.
+    let mut settings = match Settings::load(&dir) {
+        Ok(settings) => settings,
+        Err(error) if matches!(action, "status" | "toggle") => return Err(error),
+        Err(_) => Settings::default(),
+    };
+    settings.mode = match action {
+        "status" => settings.mode,
+        "computer" => Mode::Computer,
+        "telegram" => Mode::Telegram,
+        "concurrent" => Mode::Concurrent,
+        "toggle" => {
+            if settings.mode == Mode::Computer {
+                Mode::Concurrent
+            } else {
+                Mode::Computer
+            }
+        }
+        _ => anyhow::bail!(
+            "Usage: /approval-mode [computer|telegram|concurrent|status|toggle] [veto-seconds: 1-60]"
+        ),
+    };
+    if let Some(seconds) = words.next() {
+        if action == "status" {
+            anyhow::bail!("status does not accept veto-seconds");
+        }
+        settings.veto_seconds = seconds.parse()?;
+    }
+    if words.next().is_some() {
+        anyhow::bail!("Too many approval-mode arguments");
+    }
+    if action != "status" {
+        if settings.mode != Mode::Computer && !dir.join("hook.json").is_file() {
+            anyhow::bail!("Configure the Telegram bridge first with scripts/configure-hook.py");
+        }
+        settings.save(&dir)?;
+    }
+    Ok(format!(
+        "Approval mode: {:?}. Telegram veto window: {}s. Applies to new requests across your sessions; pending requests keep their handler.",
+        settings.mode, settings.veto_seconds
+    ))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn command_changes_mode_and_rejects_invalid_deadlines() {
+        let dir = tempfile::tempdir().unwrap();
+        std::fs::write(dir.path().join("hook.json"), "{}").unwrap();
+        command_in(dir.path(), "concurrent 5").unwrap();
+        assert_eq!(Settings::load(dir.path()).unwrap().mode, Mode::Concurrent);
+        assert!(command_in(dir.path(), "concurrent 0").is_err());
+        assert!(command_in(dir.path(), "concurrent 61").is_err());
+        assert!(command_in(dir.path(), "concurrent 5 extra").is_err());
+        assert_eq!(Settings::load(dir.path()).unwrap().veto_seconds, 5);
+        command_in(dir.path(), "computer").unwrap();
+        assert_eq!(Settings::load(dir.path()).unwrap().mode, Mode::Computer);
+    }
+
+    #[test]
+    fn status_does_not_write_and_explicit_selection_repairs_invalid_settings() {
+        let dir = tempfile::tempdir().unwrap();
+        assert!(
+            command_in(dir.path(), "status")
+                .unwrap()
+                .contains("Computer")
+        );
+        assert!(!dir.path().join("mode.json").exists());
+        std::fs::write(dir.path().join("mode.json"), "broken").unwrap();
+        assert!(command_in(dir.path(), "toggle").is_err());
+        command_in(dir.path(), "computer").unwrap();
+        assert_eq!(Settings::load(dir.path()).unwrap().mode, Mode::Computer);
+    }
+}
