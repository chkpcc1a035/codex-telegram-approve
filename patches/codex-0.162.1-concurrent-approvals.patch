diff --git a/codex-rs/app-server/src/telegram_approvals.rs b/codex-rs/app-server/src/telegram_approvals.rs
new file mode 100644
index 0000000..f9f255a
--- /dev/null
+++ b/codex-rs/app-server/src/telegram_approvals.rs
@@ -0,0 +1,90 @@
+//! External reviewer for already-created native approval requests.
+//! This layer is reached only after core policy hooks and reviewer routing.
+use crate::outgoing_message::{ClientRequestResult, ThreadScopedOutgoingMessageSender};
+use codex_app_server_protocol::{
+    RequestId, ServerNotification, TelegramApprovalUpdatedNotification,
+};
+use codex_telegram_approvals::{Mode, Outcome, Settings, Status};
+use serde_json::{Value, json};
+use std::time::Duration;
+use tokio::sync::{mpsc, oneshot};
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn wrap(
+    mut native: oneshot::Receiver<ClientRequestResult>,
+    outgoing: ThreadScopedOutgoingMessageSender,
+    request_id: RequestId,
+    thread_id: String,
+    approval_id: String,
+    method: &'static str,
+    params: Value,
+) -> oneshot::Receiver<ClientRequestResult> {
+    let Ok(dir) = codex_telegram_approvals::config_dir() else {
+        return native;
+    };
+    let Ok(settings) = Settings::load(&dir) else {
+        return native;
+    };
+    if settings.mode != Mode::Concurrent {
+        return native;
+    }
+    let (mut sender, receiver) = oneshot::channel();
+    tokio::spawn(async move {
+        let (updates, mut statuses) = mpsc::unbounded_channel();
+        let outcome = {
+            let arbitration = codex_telegram_approvals::arbitrate(
+                &mut native,
+                codex_telegram_approvals::request(
+                    &dir,
+                    method,
+                    params.clone(),
+                    settings.veto_seconds,
+                ),
+                Duration::from_secs(settings.veto_seconds),
+                updates,
+            );
+            tokio::pin!(arbitration);
+            loop {
+                tokio::select! {
+                    biased;
+                    _ = sender.closed() => return,
+                    outcome = &mut arbitration => break outcome,
+                    Some(status) = statuses.recv() => {
+                        let message = match status {
+                            Status::Waiting => "Telegram: waiting · terminal priority".to_string(),
+                            Status::Countdown(approved, seconds) => format!("Telegram: {} · override: {seconds}s", if approved { "approved" } else { "denied" }),
+                            Status::Unavailable => "Telegram: unavailable · use terminal".to_string(),
+                        };
+                        outgoing.send_server_notification(ServerNotification::TelegramApprovalUpdated(TelegramApprovalUpdatedNotification {
+                            thread_id: thread_id.clone(), approval_id: approval_id.clone(), message,
+                        })).await;
+                    }
+                }
+            }
+        };
+        // Drop the HTTP future before resolving: a native vote disconnects the
+        // bridge and removes the Telegram buttons. No background poller survives.
+
+        let result = match outcome {
+            Outcome::Terminal(result) => result,
+            Outcome::Telegram(approved) => {
+                // Callback removal is the commit point. A terminal reply that
+                // claimed the callback while the deadline fired still wins.
+                if !outgoing.cancel_request(&request_id).await {
+                    native.await
+                } else {
+                    let response = if method == "item/permissions/requestApproval" {
+                        json!({"permissions": if approved { params["permissions"].clone() } else { json!({}) }, "scope": "turn"})
+                    } else {
+                        json!({"decision": if approved { "accept" } else { "decline" }})
+                    };
+                    Ok(Ok(response))
+                }
+            }
+        };
+        if let Ok(result) = result {
+            let _ = sender.send(result);
+        }
+    });
+    receiver
+}
